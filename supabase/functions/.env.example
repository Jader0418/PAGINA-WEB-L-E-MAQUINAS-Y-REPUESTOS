# Copia este archivo como supabase/functions/.env para desarrollo local.
# NUNCA agregues el archivo .env real a Git.

# Supabase inyecta SUPABASE_URL y claves del proyecto en sus runtimes locales/hosted.
# Para probar localmente, rellena los valores con tu proyecto Supabase:
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY

# Sitio web permitido para llamadas CORS.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://jader0418.github.io

# Completar solo después de aprobar y publicar la política real de protección de datos.
PRIVACY_POLICY_APPROVED=false
PRIVACY_POLICY_VERSION=v1.0-borrador

# Correo transaccional Resend. Requiere dominio verificado.
RESEND_API_KEY=re_TU_API_KEY
RESEND_FROM_EMAIL=L&E Cotizaciones <cotizaciones@TU_DOMINIO_VERIFICADO>
QUOTE_NOTIFICATION_EMAIL=lyemaquinasyrepuestos@gmail.com
QUOTE_REPLY_TO=lyemaquinasyrepuestos@gmail.com
